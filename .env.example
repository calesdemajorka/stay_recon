# Documents what Render sets in production (see render.yaml). Local dev needs
# none of these — settings.py falls back to SQLite + DEBUG=True + an insecure
# placeholder key when they're unset. This file is not auto-loaded (no
# python-dotenv wired); it's documentation only.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
DATABASE_URL=

# Set once in the Render dashboard (sync: false — not generated, not committed).
# Bootstraps one superuser on deploy since the free tier has no SSH/shell to
# run createsuperuser interactively (see accounts/management/commands/bootstrap_superuser.py).
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Set once in the Render dashboard (sync: false). Real email delivery via
# Resend's SMTP relay when set; falls back to the console backend (as today)
# when unset — no behavior change locally.
RESEND_API_KEY=
# Shared Resend sender — only reliably delivers to the Resend account
# owner's own inbox until a custom domain is verified (accepted limitation,
# see context/changes/organiser-auth-app-scaffold/plan.md).
DEFAULT_FROM_EMAIL=onboarding@resend.dev
